    <div class="overlay">
        <img src="/images/cute-girl-doll-ai-generated.png" class="logo" alt="barbie Logo" style="width: 30rem; height: 35rem;" data-aos="fade-right" />
        <h1 data-aos="fade-down" >✨ Welcome to Barbella Inventory</h1>
        <p data-aos="fade-up" >🩷 Keep track of your Barbies sets with ease</p>
        <a asp-controller="Lego" asp-action="LegoList" class="btn btn-warning btn-lg" data-aos="fade-up">🩰 View Barbies Collection</a>
